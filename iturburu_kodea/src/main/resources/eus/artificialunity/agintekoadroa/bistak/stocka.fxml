<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Stocka gaur: abisu-banda, iragazkia eta taula -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="eus.artificialunity.agintekoadroa.kontroladoreak.StockaKontroladorea"
      styleClass="pantaila" spacing="16" minHeight="560">
    <Label fx:id="abisuBanda" styleClass="banda" wrapText="true" maxWidth="Infinity" minHeight="-Infinity"/>
    <VBox styleClass="txartel-zuria" spacing="8" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Biltegiko stocka gaur" styleClass="atal-izenburua"/>
            <Region HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="baxuakBakarrik" text="Stock baxukoak bakarrik erakutsi" onAction="#iragazkiaAldatu">
                <tooltip>
                    <Tooltip text="Markatu minimotik behera dauden produktuak bakarrik ikusteko"/>
                </tooltip>
            </CheckBox>
        </HBox>
        <Label text="Data-iragazkiak ez die stockari eragiten: beti gaurko egoera da. Jarri sagua barraren gainean xehetasunak ikusteko."
               styleClass="azalpen-txikia" wrapText="true"/>
        <TableView fx:id="taula" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="egoeraZutabea" text="Egoera" prefWidth="90"/>
                <TableColumn fx:id="erreferentziaZutabea" text="Erreferentzia" prefWidth="105"/>
                <TableColumn fx:id="produktuaZutabea" text="Produktua" prefWidth="330"/>
                <TableColumn fx:id="kategoriaZutabea" text="Kategoria" prefWidth="140"/>
                <TableColumn fx:id="stockaZutabea" text="Stocka" prefWidth="250"/>
                <TableColumn fx:id="minimoaZutabea" text="Minimoa" prefWidth="85" styleClass="zenbakia"/>
                <TableColumn fx:id="maximoaZutabea" text="Maximoa" prefWidth="85" styleClass="zenbakia"/>
                <TableColumn fx:id="faltaZutabea" text="Falta" prefWidth="70" styleClass="zenbakia"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
