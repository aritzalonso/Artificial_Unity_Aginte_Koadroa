<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Kategoriak: tarta-grafikoa eta taula -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="eus.artificialunity.agintekoadroa.kontroladoreak.KategoriakKontroladorea"
      styleClass="pantaila" spacing="16" minHeight="620">
    <VBox styleClass="txartel-zuria" spacing="8" HBox.hgrow="ALWAYS" minWidth="460">
        <Label text="Salmenten banaketa kategoriaka (eurotan)" styleClass="atal-izenburua"/>
        <PieChart fx:id="grafikoa" VBox.vgrow="ALWAYS" styleClass="tarta-grafikoa"/>
    </VBox>
    <VBox styleClass="txartel-zuria" spacing="8" HBox.hgrow="ALWAYS" minWidth="440">
        <Label text="Kategoria bakoitzeko zifrak" styleClass="atal-izenburua"/>
        <TableView fx:id="taula" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="kategoriaZutabea" text="Kategoria" prefWidth="170"/>
                <TableColumn fx:id="unitateakZutabea" text="Unitateak" prefWidth="100" styleClass="zenbakia"/>
                <TableColumn fx:id="zenbatekoaZutabea" text="Salmentak" prefWidth="140" styleClass="zenbakia"/>
                <TableColumn fx:id="ehunekoaZutabea" text="Ehunekoa" prefWidth="100" styleClass="zenbakia"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</HBox>
