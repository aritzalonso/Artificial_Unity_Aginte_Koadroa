<?xml version="1.0" encoding="UTF-8"?>

<?import eus.artificialunity.agintekoadroa.osagaiak.KpiTxartela?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<!-- Kobratzeko fakturak: txartelak, iragazkia eta taula -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="eus.artificialunity.agintekoadroa.kontroladoreak.FakturakKontroladorea"
      styleClass="pantaila" spacing="16" minHeight="600">
    <TilePane hgap="14" vgap="14" prefColumns="3" prefTileWidth="280" tileAlignment="TOP_LEFT">
        <KpiTxartela fx:id="guztiraTxartela" izenburua="Kobratzeko guztira"
                     laguntza="Bezeroek ordaintzeko duten guztia, BEZarekin."/>
        <KpiTxartela fx:id="beranduTxartela" izenburua="Berandu"
                     laguntza="Muga-eguna pasatu den eta oraindik ordaindu ez diren fakturak. Bezeroari deitu!"/>
        <KpiTxartela fx:id="garaizTxartela" izenburua="Oraindik garaiz"
                     laguntza="Muga-eguna oraindik iritsi ez den fakturak."/>
    </TilePane>
    <VBox styleClass="txartel-zuria" spacing="8" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Ordaindu gabeko fakturak" styleClass="atal-izenburua"/>
            <Region HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="beranduBakarrik" text="Berandu daudenak bakarrik erakutsi" onAction="#iragazkiaAldatu">
                <tooltip>
                    <Tooltip text="Markatu muga-eguna pasatu zaien fakturak bakarrik ikusteko"/>
                </tooltip>
            </CheckBox>
        </HBox>
        <Label text="Data-iragazkiak ez die fakturei eragiten: gaur kobratzeko dauden guztiak agertzen dira. Zenbatekoak BEZarekin."
               styleClass="azalpen-txikia" wrapText="true"/>
        <TableView fx:id="taula" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="egoeraZutabea" text="Egoera" prefWidth="95"/>
                <TableColumn fx:id="fakturaZutabea" text="Faktura" prefWidth="140"/>
                <TableColumn fx:id="bezeroaZutabea" text="Bezeroa" prefWidth="230"/>
                <TableColumn fx:id="dataZutabea" text="Data" prefWidth="105"/>
                <TableColumn fx:id="mugaZutabea" text="Muga-eguna" prefWidth="110"/>
                <TableColumn fx:id="guztiraZutabea" text="Guztira" prefWidth="120" styleClass="zenbakia"/>
                <TableColumn fx:id="ordaintzekoZutabea" text="Kobratzeko" prefWidth="120" styleClass="zenbakia"/>
                <TableColumn fx:id="beranduZutabea" text="Berandu (egunak)" prefWidth="130" styleClass="zenbakia"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
