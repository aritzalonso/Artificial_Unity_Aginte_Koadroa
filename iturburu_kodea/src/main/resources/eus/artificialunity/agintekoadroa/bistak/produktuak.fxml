<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Produktu salduenak: barra-grafikoa (unitateak / eurotan) eta taula -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="eus.artificialunity.agintekoadroa.kontroladoreak.ProduktuakKontroladorea"
      styleClass="pantaila" spacing="16" minHeight="560">
    <fx:define>
        <ToggleGroup fx:id="neurria"/>
    </fx:define>
    <VBox styleClass="txartel-zuria" spacing="8" HBox.hgrow="ALWAYS" minWidth="520">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Produktu salduenak" styleClass="atal-izenburua"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Erakutsi:" styleClass="iragazki-etiketa"/>
            <ToggleButton fx:id="unitateakBotoia" text="Unitateak" toggleGroup="$neurria" selected="true"
                          styleClass="aukera-botoia"/>
            <ToggleButton fx:id="euroakBotoia" text="Eurotan" toggleGroup="$neurria" styleClass="aukera-botoia"/>
        </HBox>
        <BarChart fx:id="grafikoa" VBox.vgrow="ALWAYS" styleClass="barra-grafikoa">
            <xAxis>
                <NumberAxis fx:id="balioArdatza" side="BOTTOM" forceZeroInRange="true"/>
            </xAxis>
            <yAxis>
                <CategoryAxis fx:id="produktuArdatza" side="LEFT"/>
            </yAxis>
        </BarChart>
    </VBox>
    <VBox styleClass="txartel-zuria" spacing="6" HBox.hgrow="ALWAYS" minWidth="460">
        <Label text="Xehetasunak" styleClass="atal-izenburua"/>
        <TableView fx:id="taula" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="postuaZutabea" text="Zk." prefWidth="45" styleClass="zenbakia"/>
                <TableColumn fx:id="erreferentziaZutabea" text="Erref." prefWidth="75"/>
                <TableColumn fx:id="produktuaZutabea" text="Produktua" prefWidth="230"/>
                <TableColumn fx:id="unitateakZutabea" text="Unitateak" prefWidth="90" styleClass="zenbakia"/>
                <TableColumn fx:id="zenbatekoaZutabea" text="Salmentak" prefWidth="120" styleClass="zenbakia"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</HBox>
