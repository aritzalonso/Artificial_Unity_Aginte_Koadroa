<?xml version="1.0" encoding="UTF-8"?>
<!-- =====================================================================
     Artificial Unity - Aginte-koadroa (JavaFX + JDBC + OpenPDF)
     Eraiki:   mvnw.cmd clean package     -> target/aginte-koadroa.jar
     Exekutatu: java -jar target/aginte-koadroa.jar
     Garapenean: mvnw.cmd javafx:run
     ===================================================================== -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eus.artificialunity</groupId>
    <artifactId>aginte-koadroa</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Artificial Unity - Aginte-koadroa</name>
    <description>Arduradunarentzako salmenten aginte-koadroa, Odoo-ren datuekin</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.bertsioa>21.0.5</javafx.bertsioa>
        <openpdf.bertsioa>2.0.3</openpdf.bertsioa>
        <postgresql.bertsioa>42.7.4</postgresql.bertsioa>
        <junit.bertsioa>5.11.3</junit.bertsioa>
        <!-- Abiarazlea ez da Application-en azpiklasea: horri esker .jar bakarrak JavaFX klase-bidean kargatzen du -->
        <klase.nagusia>eus.artificialunity.agintekoadroa.Abiarazlea</klase.nagusia>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.bertsioa}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.bertsioa}</version>
        </dependency>
        <!-- SwingFXUtils: grafikoaren irudia PDFra pasatzeko -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.bertsioa}</version>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.bertsioa}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.bertsioa}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.bertsioa}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>aginte-koadroa</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>

            <!-- Garapenean exekutatzeko: mvnw.cmd javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>eus.artificialunity.agintekoadroa.AginteKoadroaApp</mainClass>
                </configuration>
            </plugin>

            <!-- .jar bakarra mendekotasun guztiekin (JavaFX barne): target/aginte-koadroa.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- GraalVM/Gluon-en metadatuak: ez dira behar eta bikoiztuta daude -->
                                        <exclude>META-INF/substrate/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${klase.nagusia}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
